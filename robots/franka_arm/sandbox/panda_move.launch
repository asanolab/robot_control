<?xml version="1.0" ?>

<launch>

  <!-- ros control -->
  <include file="$(find jsk_panda_startup)/launch/franka_robot_control.launch" >
    <arg name="robot_ip" default="172.16.0.2" />
    <arg name="load_gripper" default="true" />
  </include>

  <!-- euslisp interface -->
  <node name="panda_ri_interface" pkg="jsk_panda_startup" type="panda-move" output="screen" />

</launch>
